{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Text styles for the tiagopedras_2026 theme, taken from DESIGN-tiago-pedras-site.md. Each style here replaces the shared style of the same name inside that theme's CSS block; a style not listed keeps the shared one. Sizes, line heights and one letter spacing are literal because the site sits off the shared ladder on purpose (12, 13, 15 and 17px, and fluid clamp() sizes that the dimension type cannot write). Families and weights alias primitives. heading-5, heading-6, label and code have no site original, so they were written for it and are also in DESIGN-tiago-pedras-site.md. The site-only styles quote, logo, label-caps and label-caps-sm are not carried over.",
  "text": {
    "title": {
      "$description": "The site's display-hero. Fluid, 32px up to 56px.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.serif}",
        "fontSize": "clamp(32px, 6vw, 56px)",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": 1.1,
        "letterSpacing": "{typography.letter-spacing.normal}"
      }
    },
    "stat": {
      "$description": "The site's display-stat, now stat. Fluid, 28px up to 40px.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.serif}",
        "fontSize": "clamp(28px, 4vw, 40px)",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": 1,
        "letterSpacing": "{typography.letter-spacing.normal}"
      }
    },
    "heading-1": {
      "$description": "The site's display-lg. Fluid, 28px up to 44px.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.serif}",
        "fontSize": "clamp(28px, 3.2vw, 44px)",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": 1.15,
        "letterSpacing": "{typography.letter-spacing.normal}"
      }
    },
    "heading-2": {
      "$description": "The site's display-section. Fluid, 22px up to 30px.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.serif}",
        "fontSize": "clamp(22px, 3.5vw, 30px)",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": 1.25,
        "letterSpacing": "{typography.letter-spacing.normal}"
      }
    },
    "heading-3": {
      "$description": "The site's display-sm. Fluid, 20px up to 26px.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.serif}",
        "fontSize": "clamp(20px, 3vw, 26px)",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": 1.3,
        "letterSpacing": "{typography.letter-spacing.normal}"
      }
    },
    "heading-4": {
      "$description": "The site's card-title.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.serif}",
        "fontSize": { "value": 17, "unit": "px" },
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": 1.25,
        "letterSpacing": "{typography.letter-spacing.normal}"
      }
    },
    "heading-5": {
      "$description": "Written for the site. Carries the display serif one step below card-title, at 15px.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.serif}",
        "fontSize": { "value": 15, "unit": "px" },
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": 1.25,
        "letterSpacing": "{typography.letter-spacing.normal}"
      }
    },
    "heading-6": {
      "$description": "Written for the site. The old eyebrow without the capitals: 13px Inter and its 0.08em tracking, which does the separating.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.inter}",
        "fontSize": { "value": 13, "unit": "px" },
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": "{typography.line-height.normal}",
        "letterSpacing": { "value": 0.08, "unit": "em" }
      }
    },
    "body": {
      "$description": "The site's body at 16px. Its 17px and 1.7 in the case-study article column are not carried over.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.inter}",
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": 1.6,
        "letterSpacing": "{typography.letter-spacing.normal}"
      }
    },
    "body-sm": {
      "$description": "The site's body-sm.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.inter}",
        "fontSize": { "value": 15, "unit": "px" },
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": 1.6,
        "letterSpacing": "{typography.letter-spacing.normal}"
      }
    },
    "label": {
      "$description": "Written for the site. Caption's 13px Inter with half the heading-6 tracking. The site sets no weight above 400, so tracking separates a label from body text.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.inter}",
        "fontSize": { "value": 13, "unit": "px" },
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": "{typography.line-height.normal}",
        "letterSpacing": { "value": 0.04, "unit": "em" }
      }
    },
    "caption": {
      "$description": "The site's caption at 13px. The site sets no line height on it, so this takes the shared normal.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.inter}",
        "fontSize": { "value": 13, "unit": "px" },
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": "{typography.line-height.normal}",
        "letterSpacing": "{typography.letter-spacing.normal}"
      }
    },
    "caption-sm": {
      "$description": "The site's caption-sm, at 12px of its 11 to 12px.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.inter}",
        "fontSize": { "value": 12, "unit": "px" },
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": "{typography.line-height.normal}",
        "letterSpacing": "{typography.letter-spacing.normal}"
      }
    },
    "code": {
      "$description": "Written for the site, which has no mono face. The system mono at 13px, with the 1.6 line height the site's body text uses.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.mono}",
        "fontSize": { "value": 13, "unit": "px" },
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": 1.6,
        "letterSpacing": "{typography.letter-spacing.normal}"
      }
    }
  }
}
