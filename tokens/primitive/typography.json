{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The parts a text style is assembled from. Each one is a single value, which is also the only kind of thing a Figma variable can hold. The assembled styles live in tokens/semantic/typography.json and land in Figma as text styles instead.",
  "typography": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "Inter", "Roboto", "Helvetica", "Arial", "sans-serif"]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["ui-monospace", "SFMono-Regular", "SF Mono", "Menlo", "Consolas", "monospace"]
      }
    },
    "size": {
      "$description": "Below xl these are the sizes the to-dos board already uses, rounded off the half-pixels it had drifted into. From xl up it is a 1.2 ratio, which is range Tenon needs for a page that is not the board.",
      "2xs": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
      "xs":  { "$type": "dimension", "$value": { "value": 11, "unit": "px" } },
      "sm":  { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "base":{ "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
      "md":  { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
      "lg":  { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "xl":  { "$type": "dimension", "$value": { "value": 19, "unit": "px" } },
      "2xl": { "$type": "dimension", "$value": { "value": 23, "unit": "px" } },
      "3xl": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
      "4xl": { "$type": "dimension", "$value": { "value": 34, "unit": "px" } },
      "5xl": { "$type": "dimension", "$value": { "value": 41, "unit": "px" } },
      "6xl": { "$type": "dimension", "$value": { "value": 49, "unit": "px" } },
      "7xl": { "$type": "dimension", "$value": { "value": 59, "unit": "px" } },
      "8xl": { "$type": "dimension", "$value": { "value": 71, "unit": "px" } }
    },
    "weight": {
      "$description": "Four. The board carries thirteen, including 520, 560, 570 and 680, which are the kind of value that gets typed once and copied forever.",
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "line-height": {
      "tight":   { "$type": "number", "$value": 1.2 },
      "snug":    { "$type": "number", "$value": 1.3 },
      "normal":  { "$type": "number", "$value": 1.4 },
      "relaxed": { "$type": "number", "$value": 1.5 },
      "loose":   { "$type": "number", "$value": 1.65 }
    },
    "letter-spacing": {
      "tight":  { "$type": "dimension", "$value": { "value": -0.01, "unit": "rem" } },
      "normal": { "$type": "dimension", "$value": { "value": 0, "unit": "rem" } },
      "wide":   { "$type": "dimension", "$value": { "value": 0.02, "unit": "rem" } },
      "wider":  { "$type": "dimension", "$value": { "value": 0.04, "unit": "rem" } }
    }
  }
}
